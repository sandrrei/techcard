<RCC>
    <qresource prefix="/qml">
        <file>Main.qml</file>
        <file>CardPage.qml</file>
        <file>ExperiencePage.qml</file>
        <file>ProjectsPage.qml</file>
        <file>SharePage.qml</file>
        <file>SetupPage.qml</file>
        <file>FilePicker.qml</file>
